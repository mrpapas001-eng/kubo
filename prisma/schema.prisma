generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VerificationType {
  PARTICULAR
  EMPRESA
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model AccountVerification {
  id            String             @id @default(cuid())
  email         String
  type          VerificationType
  status        VerificationStatus @default(PENDING)
  whatsappNumber String?
  rutUrl        String?
  documentUrl   String?
  adminNote     String?
  submittedAt   DateTime           @default(now())
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([email, type])
  @@index([email])
  @@index([status])
  @@index([type])
  @@index([submittedAt])
}

enum AidRequestStatus {
  PENDING
  APPROVED
  REJECTED
  MATCHED
  COMPLETED
  CANCELLED
}

model AidRequest {
  id               String           @id @default(cuid())
  ownerEmail       String
  ownerName        String?
  whatsappNumber   String
  title            String
  category         String
  city             String
  description      String
  contextImageUrl  String?
  status           AidRequestStatus @default(PENDING)
  isActive         Boolean?
  rejectionReason  String?
  adminNotes       String?
  matchedListingId String?
  createdAt        DateTime         @default(now())
  reviewedAt       DateTime?
  completedAt      DateTime?
  updatedAt        DateTime         @updatedAt

  @@unique([ownerEmail, isActive])
  @@index([status])
  @@index([city])
  @@index([category])
  @@index([createdAt])
  @@index([ownerEmail])
}

model Listing {
  id              String   @id @default(cuid())
  title           String
  description     String
  phone           String?
  price           Float?
  currency        String
  city            String
  location        String?
  lat             Float?
  lng             Float?
  categorySlug    String
  subcategorySlug String
  template        String
  sellerType      String
  isVerified      Boolean  @default(false)
  imageUrl        String?
  details         Json?

  isFeatured      Boolean   @default(false)
  featuredUntil   DateTime?
  premiumPlan     String?
  premiumUntil    DateTime?

  views           Int       @default(0)
  ownerEmail      String?
  ownerName       String?
  ownerImage      String?

  isBusiness       Boolean  @default(false)
  businessName     String?
  businessLogo     String?
  businessType     String?
  businessSlug     String?
  businessDescription String?
  businessWebsite    String?
  businessInstagram  String?
  businessFacebook   String?
  businessWhatsapp   String?
  businessVerified Boolean  @default(false)

  status           String   @default("active")
  hiddenReason     String?
  reportedCount    Int      @default(0)

  createdAt        DateTime @default(now())
  isPremium        Boolean  @default(false)

  reports          ListingReport[]

  @@index([categorySlug])
  @@index([subcategorySlug])
  @@index([city])
  @@index([ownerEmail])
  @@index([createdAt])
  @@index([isPremium])
  @@index([isFeatured])
  @@index([premiumUntil])
  @@index([featuredUntil])
  @@index([isBusiness])
  @@index([businessSlug])
  @@index([businessVerified])
  @@index([status])
  @@index([reportedCount])
}

model ListingReport {
  id            String   @id @default(cuid())
  listingId     String
  reporterEmail String?
  reason        String
  details       String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([reporterEmail])
  @@index([status])
  @@index([createdAt])
}

model BusinessVerificationRequest {
  id                  String   @id @default(cuid())
  ownerEmail          String
  ownerName           String?
  businessName        String
  businessSlug        String
  businessDescription String?
  rutUrl              String
  status              String   @default("pending")
  adminNote           String?
  createdAt           DateTime @default(now())
  reviewedAt          DateTime?

  @@index([ownerEmail])
  @@index([businessSlug])
  @@index([status])
  @@index([createdAt])
}

model IdentityVerificationRequest {
  id          String   @id @default(cuid())
  ownerEmail  String
  ownerName   String?
  documentUrl String
  status      String   @default("pending")
  adminNote   String?
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?

  @@index([ownerEmail])
  @@index([status])
  @@index([createdAt])
}

model SponsorAd {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  ctaText   String?
  ctaUrl    String?
  type      String
  placement String
  categorySlug String?
  priority  Int      @default(0)
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([placement])
  @@index([isActive])
  @@index([startAt])
  @@index([endAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userEmail String
  listingId String
  createdAt DateTime @default(now())

  @@unique([userEmail, listingId])
  @@index([userEmail])
  @@index([listingId])
}

model Conversation {
  id             String   @id @default(cuid())
  listingId      String
  listingTitle   String
  buyerEmail     String
  buyerName      String?
  sellerEmail    String
  sellerName     String?
  createdAt      DateTime @default(now())

  messages       Message[]

  @@index([listingId])
  @@index([buyerEmail])
  @@index([sellerEmail])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderEmail    String
  senderName     String?
  body           String
  createdAt      DateTime @default(now())
  readAt         DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderEmail])
  @@index([createdAt])
}

